LITMAN_CORE_CODEX_MODEL=gpt-5.5
LITMAN_CORE_CODEX_TIMEOUT_SECONDS=1800
LITMAN_CORE_CODEX_CONTEXT_WINDOW_TOKENS=1050000
LITMAN_CORE_CODEX_CONTEXT_RESERVE_TOKENS=50000
LITMAN_CORE_INPUT_DIR=./local-data/input
LITMAN_CORE_OUTPUT_DIR=./local-data/output
LITMAN_CORE_RUNS_HOST_DIR=./runs
LITMAN_CORE_JOB_DIR=./.local-state/mounts/job
LITMAN_CORE_SECRETS_DIR=./local-secrets
LITMAN_CORE_CODEX_STATE_DIR=./.local-state/codex
LITMAN_CORE_CODEX_AUTH_MODE=chatgpt
LITMAN_CORE_CODEX_API_KEY_FILE=
LITMAN_CORE_CODEX_PREFLIGHT=true
LITMAN_CORE_CODEX_PREFLIGHT_TIMEOUT_SECONDS=120
HOST_UID=1000
HOST_GID=1000
# chatgpt: copy ~/.codex/auth.json to .local-state/codex/auth.json (mode 0600).
# api-key: use /run/secrets/openai_api_key in LITMAN_CORE_CODEX_API_KEY_FILE.
# Google credentials are mounted read-only but share the container with Codex.
# local-secrets/google-service-account.json is optional; it is needed only for Drive jobs.
