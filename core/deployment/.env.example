# Autenticación de Codex: chatgpt usa CODEX_HOME/auth.json; api-key usa
# LITMAN_CORE_CODEX_API_KEY_FILE.
LITMAN_CORE_CODEX_AUTH_MODE=chatgpt

# El proveedor y el modelo sólo se eligen en config.toml ([llm] provider/model);
# estas variables son sólo de máquina (binario y configuración local de Claude).
# LITMAN_CORE_CLAUDE_BINARY=claude
# LITMAN_CORE_CLAUDE_CONFIG_DIR=./local-secrets/claude

# Archivo JSON de credenciales de Google. Solo es necesario para entrada o
# publicación en Google Drive. Vacío significa que no se usa Drive.
GOOGLE_APPLICATION_CREDENTIALS=

# Directorio de estado y autenticación de Codex.
CODEX_HOME=./local-secrets/codex

# Archivo que contiene la API key cuando LITMAN_CORE_CODEX_AUTH_MODE=api-key.
# LITMAN_CORE_CODEX_API_KEY_FILE=

# Ejecutable de Codex. Por defecto: codex.
# LITMAN_CORE_CODEX_BINARY=codex

# Workspace temporal de LitMan. Por defecto: /tmp/litman-core.
# LITMAN_CORE_WORKSPACE_DIR=

# Directorio HOME que recibe el proceso de Codex. Por defecto, el HOME del
# usuario en la CLI local; Docker Compose fija /tmp/litman-core/home.
# HOME=/tmp/litman-core/home

# Variables usadas por Docker Compose para asignar el usuario del host.
# Por defecto: 1000.
HOST_UID=1000
HOST_GID=1000

# Directorio de secretos montado en /run/secrets por Docker Compose.
# Por defecto: ../local-secrets, relativo a deployment/docker/compose.yaml.
# LITMAN_CORE_SECRETS_DIR=

# Directorio persistente del estado de Codex montado en el contenedor.
# Por defecto: ../local-secrets/codex, relativo a deployment/docker/compose.yaml.
# LITMAN_CORE_CODEX_STATE_DIR=
