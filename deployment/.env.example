# Authentication and secret locations only. Values are loaded before config.toml.
LITMAN_CORE_CODEX_AUTH_MODE=chatgpt
# Para usar API key, cambie el modo y descomente la ruta:
# LITMAN_CORE_CODEX_AUTH_MODE=api-key
# LITMAN_CORE_CODEX_API_KEY_FILE=./local-secrets/openai-api-key
GOOGLE_APPLICATION_CREDENTIALS=./local-secrets/google-service-account.json
CODEX_HOME=./local-secrets/codex
HOST_UID=1000
HOST_GID=1000
