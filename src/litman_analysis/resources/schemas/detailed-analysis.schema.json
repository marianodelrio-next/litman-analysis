{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detailed-analysis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cabecera", "contexto", "objetivos", "alcance", "trabajos", "fases", "entregables_contrato", "documentos_oferta", "equipo", "tecnologias", "requisitos_oferta", "criterios_adjudicacion", "simulador_economico", "estructura_documento_tecnico", "memoria_tecnica", "pendientes", "evidencias", "calidad"],
  "properties": {
    "schema_version": {"type": "string", "const": "detailed-analysis-v1"},
    "cabecera": {"$ref": "#/$defs/cabecera"},
    "contexto": {"type": ["string", "null"]},
    "objetivos": {"type": "array", "items": {"type": "string"}},
    "alcance": {"type": "array", "items": {"type": "string"}},
    "trabajos": {"type": "array", "items": {"type": "string"}},
    "fases": {"type": "array", "items": {"$ref": "#/$defs/fase"}},
    "entregables_contrato": {"type": "array", "items": {"$ref": "#/$defs/entidad"}},
    "documentos_oferta": {"type": "array", "items": {"$ref": "#/$defs/documento_oferta"}},
    "equipo": {"type": "array", "items": {"$ref": "#/$defs/entidad"}},
    "tecnologias": {"type": "array", "items": {"type": "string"}},
    "requisitos_oferta": {"type": "array", "items": {"$ref": "#/$defs/requisito"}},
    "criterios_adjudicacion": {"type": "array", "items": {"$ref": "#/$defs/criterio"}},
    "simulador_economico": {"$ref": "#/$defs/simulador_economico"},
    "estructura_documento_tecnico": {"type": "array", "items": {"type": "string"}},
    "memoria_tecnica": {"$ref": "#/$defs/memoria_tecnica"},
    "pendientes": {"type": "array", "items": {"$ref": "#/$defs/pendiente"}},
    "evidencias": {"type": "array", "items": {"$ref": "#/$defs/evidencia"}},
    "calidad": {"$ref": "#/$defs/calidad"}
  },
  "$defs": {
    "cabecera": {"type": "object", "additionalProperties": false, "required": ["nombre", "expediente", "organismo", "fecha_limite", "presupuesto_sin_iva", "moneda"], "properties": {"nombre": {"type": ["string", "null"]}, "expediente": {"type": ["string", "null"]}, "organismo": {"type": ["string", "null"]}, "fecha_limite": {"type": ["string", "null"]}, "presupuesto_sin_iva": {"type": ["number", "null"]}, "moneda": {"type": ["string", "null"]}}},
    "fase": {"type": "object", "additionalProperties": false, "required": ["nombre", "descripcion", "plazo", "entregables"], "properties": {"nombre": {"type": "string"}, "descripcion": {"type": ["string", "null"]}, "plazo": {"type": ["string", "null"]}, "entregables": {"type": "array", "items": {"type": "string"}}}},
    "entidad": {"type": "object", "additionalProperties": false, "required": ["nombre", "descripcion"], "properties": {"nombre": {"type": "string"}, "descripcion": {"type": ["string", "null"]}}},
    "documento_oferta": {"type": "object", "additionalProperties": false, "required": ["nombre", "sobre", "obligatorio", "descripcion"], "properties": {"nombre": {"type": "string"}, "sobre": {"type": ["string", "null"]}, "obligatorio": {"type": ["boolean", "null"]}, "descripcion": {"type": ["string", "null"]}}},
    "requisito": {"type": "object", "additionalProperties": false, "required": ["descripcion", "tipo", "obligatorio", "donde_responder"], "properties": {"descripcion": {"type": "string"}, "tipo": {"type": "string"}, "obligatorio": {"type": ["boolean", "null"]}, "donde_responder": {"type": ["string", "null"]}}},
    "criterio": {"type": "object", "additionalProperties": false, "required": ["nombre", "puntuacion_maxima", "tipo", "donde_responder", "descripcion"], "properties": {"nombre": {"type": "string"}, "puntuacion_maxima": {"type": ["number", "null"]}, "tipo": {"type": "string"}, "donde_responder": {"type": ["string", "null"]}, "descripcion": {"type": ["string", "null"]}}},
    "formula_precio": {"type": "object", "additionalProperties": false, "required": ["tipo", "expresion_literal", "puntuacion_maxima", "redondeo_decimales", "evidencia"], "properties": {"tipo": {"type": "string", "enum": ["inversa_oferta_minima", "lineal_baja", "otra_no_soportada", "no_localizada"]}, "expresion_literal": {"type": ["string", "null"]}, "puntuacion_maxima": {"type": ["number", "null"], "minimum": 0}, "redondeo_decimales": {"type": ["integer", "null"], "minimum": 0}, "evidencia": {"anyOf": [{"$ref": "#/$defs/evidencia"}, {"type": "null"}]}}},
    "criterio_simulador": {"type": "object", "additionalProperties": false, "required": ["nombre", "tipo", "puntuacion_maxima", "valor_minimo", "valor_maximo", "unidad", "descripcion", "evidencia"], "properties": {"nombre": {"type": "string", "minLength": 1}, "tipo": {"type": "string", "enum": ["automatico_cuantitativo", "automatico_binario", "juicio_valor"]}, "puntuacion_maxima": {"type": ["number", "null"], "minimum": 0}, "valor_minimo": {"type": ["number", "null"]}, "valor_maximo": {"type": ["number", "null"]}, "unidad": {"type": ["string", "null"]}, "descripcion": {"type": ["string", "null"]}, "evidencia": {"anyOf": [{"$ref": "#/$defs/evidencia"}, {"type": "null"}]}}},
    "regla_baja": {"type": "object", "additionalProperties": false, "required": ["min_licitadores", "max_licitadores", "base", "referencia", "peso_calidad", "descripcion", "evidencia"], "properties": {"min_licitadores": {"type": "integer", "minimum": 1}, "max_licitadores": {"type": ["integer", "null"], "minimum": 1}, "base": {"type": ["number", "null"], "minimum": 0}, "referencia": {"type": "string", "enum": ["media_ofertas", "presupuesto_maximo", "otra"]}, "peso_calidad": {"type": ["number", "null"], "minimum": 0}, "descripcion": {"type": "string"}, "evidencia": {"anyOf": [{"$ref": "#/$defs/evidencia"}, {"type": "null"}]}}},
    "baja_anormal": {"type": "object", "additionalProperties": false, "required": ["aplica", "maximo_cualitativo", "comparador", "reglas", "formula_literal", "advertencias", "evidencias"], "properties": {"aplica": {"type": ["boolean", "null"]}, "maximo_cualitativo": {"type": ["number", "null"], "exclusiveMinimum": 0}, "comparador": {"type": ["string", "null"], "enum": ["menor", "menor_o_igual", null]}, "reglas": {"type": "array", "items": {"$ref": "#/$defs/regla_baja"}}, "formula_literal": {"type": ["string", "null"]}, "advertencias": {"type": "array", "items": {"type": "string"}}, "evidencias": {"type": "array", "items": {"$ref": "#/$defs/evidencia"}}}},
    "simulador_economico": {"type": "object", "additionalProperties": false, "required": ["aplicable", "presupuesto_maximo_sin_iva", "moneda", "puntuacion_total", "formula_precio", "criterios_no_precio", "baja_anormal", "restricciones", "advertencias"], "properties": {"aplicable": {"type": ["boolean", "null"]}, "presupuesto_maximo_sin_iva": {"type": ["number", "null"], "minimum": 0}, "moneda": {"type": ["string", "null"]}, "puntuacion_total": {"type": ["number", "null"], "minimum": 0}, "formula_precio": {"$ref": "#/$defs/formula_precio"}, "criterios_no_precio": {"type": "array", "items": {"$ref": "#/$defs/criterio_simulador"}}, "baja_anormal": {"$ref": "#/$defs/baja_anormal"}, "restricciones": {"type": "array", "items": {"type": "string"}}, "advertencias": {"type": "array", "items": {"type": "string"}}}},
    "pendiente": {"type": "object", "additionalProperties": false, "required": ["descripcion", "motivo", "destino"], "properties": {"descripcion": {"type": "string"}, "motivo": {"type": ["string", "null"]}, "destino": {"type": "string", "enum": ["resumen", "documento_tecnico", "economico", "general"]}}},
    "evidencia": {"type": "object", "additionalProperties": false, "required": ["campo", "documento_id", "pagina", "texto_citado"], "properties": {"campo": {"type": "string"}, "documento_id": {"type": "string"}, "pagina": {"type": ["integer", "string", "null"]}, "texto_citado": {"type": ["string", "null"]}}},
    "seccion_memoria": {"type": "object", "additionalProperties": false, "required": ["orden", "titulo", "descripcion", "obligatoria", "puntuacion", "limite_paginas", "requisitos_relacionados", "evidencias"], "properties": {"orden": {"type": "integer", "minimum": 1}, "titulo": {"type": "string", "minLength": 1}, "descripcion": {"type": ["string", "null"]}, "obligatoria": {"type": ["boolean", "null"]}, "puntuacion": {"type": ["number", "null"]}, "limite_paginas": {"type": ["number", "null"], "exclusiveMinimum": 0}, "requisitos_relacionados": {"type": "array", "items": {"type": "string"}}, "evidencias": {"type": "array", "items": {"$ref": "#/$defs/evidencia"}}}},
    "formato_memoria": {"type": "object", "additionalProperties": false, "required": ["paginas_maximas", "fuente", "tamano_pt", "interlineado", "margen_superior_cm", "margen_inferior_cm", "margen_izquierdo_cm", "margen_derecho_cm"], "properties": {"paginas_maximas": {"type": ["integer", "null"], "minimum": 1}, "fuente": {"type": ["string", "null"]}, "tamano_pt": {"type": ["number", "null"], "exclusiveMinimum": 0}, "interlineado": {"type": ["number", "string", "null"]}, "margen_superior_cm": {"type": ["number", "null"], "minimum": 0}, "margen_inferior_cm": {"type": ["number", "null"], "minimum": 0}, "margen_izquierdo_cm": {"type": ["number", "null"], "minimum": 0}, "margen_derecho_cm": {"type": ["number", "null"], "minimum": 0}}},
    "regla_memoria": {"type": "object", "additionalProperties": false, "required": ["tipo", "descripcion", "consecuencia", "evidencia"], "properties": {"tipo": {"type": "string", "enum": ["obligacion", "prohibicion", "advertencia"]}, "descripcion": {"type": "string"}, "consecuencia": {"type": ["string", "null"]}, "evidencia": {"anyOf": [{"$ref": "#/$defs/evidencia"}, {"type": "null"}]}}},
    "memoria_tecnica": {"type": "object", "additionalProperties": false, "required": ["requerida", "nombre_documento", "idioma", "estructura_impuesta", "secciones", "formato", "reglas", "portada_computa_limite", "indice_computa_limite", "anexos_computan_limite"], "properties": {"requerida": {"type": ["boolean", "null"]}, "nombre_documento": {"type": ["string", "null"]}, "idioma": {"type": ["string", "null"]}, "estructura_impuesta": {"type": ["boolean", "null"]}, "secciones": {"type": "array", "items": {"$ref": "#/$defs/seccion_memoria"}}, "formato": {"$ref": "#/$defs/formato_memoria"}, "reglas": {"type": "array", "items": {"$ref": "#/$defs/regla_memoria"}}, "portada_computa_limite": {"type": ["boolean", "null"]}, "indice_computa_limite": {"type": ["boolean", "null"]}, "anexos_computan_limite": {"type": ["boolean", "null"]}}},
    "calidad": {"type": "object", "additionalProperties": false, "required": ["estado", "limitaciones"], "properties": {"estado": {"type": "string", "enum": ["suficiente", "parcial", "insuficiente"]}, "limitaciones": {"type": "array", "items": {"type": "string"}}}}
  }
}
