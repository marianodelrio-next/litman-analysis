{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "economic_inputs.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scenarios", "notes"],
  "properties": {
    "version": {"const": "economic-inputs-v1"},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "bidder": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "price", "criterion_scores"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "price": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "criterion_scores": {"type": "object", "additionalProperties": {"type": ["number", "null"], "minimum": 0}}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "bidders"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "bidders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bidder"}}
      }
    }
  }
}
