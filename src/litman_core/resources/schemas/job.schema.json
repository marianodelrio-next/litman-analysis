{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "litman-analysis-job-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "job_type", "input", "output"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "job_type": {"enum": ["assessment", "detailed-analysis"]},
    "input": {"$ref": "#/$defs/input"},
    "output": {"$ref": "#/$defs/output"},
    "options": {"type": "object"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location"],
      "properties": {
        "kind": {"enum": ["local", "google-drive"]},
        "location": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location"],
      "properties": {
        "kind": {"enum": ["local", "google-drive"]},
        "location": {"type": "string", "minLength": 1}
      }
    }
  }
}
